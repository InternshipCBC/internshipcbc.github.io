/**
 * Cohort V23 — WebApp.gs : the shared database + the API every dashboard talks to.
 * Deploy: Deploy → New deployment → ⚙ Web app → Execute as: Me · Who has access: Anyone → Deploy.
 * Updating later: Deploy → Manage deployments → ✎ → Version: New version → Deploy (the /exec URL stays the same).
 * Settings live in Code.gs. Do not edit this file.
 */

/* ============================== HTTP entry ============================== */
function doGet(e){
  const p = (e && e.parameter) || {};
  let out;
  try{ out = route_(p.action || "ping", p, false); }catch(err){ out = { ok: false, error: String(err && err.message || err) }; }
  return reply_(out, p.callback);
}
function doPost(e){
  let body = {};
  try{ body = JSON.parse((e && e.postData && e.postData.contents) || "{}"); }catch(err){ return reply_({ ok: false, error: "bad json" }); }
  let out;
  try{ out = route_(body.action, body, true); }catch(err){ out = { ok: false, error: String(err && err.message || err) }; }
  return reply_(out, null);
}
function reply_(obj, cb){
  obj.version = COHORT_SERVER_VERSION;
  const s = JSON.stringify(obj);
  if(cb && /^[A-Za-z_$][\w$]{0,60}$/.test(cb)) return ContentService.createTextOutput(cb + "(" + s + ")").setMimeType(ContentService.MimeType.JAVASCRIPT);
  return ContentService.createTextOutput(s).setMimeType(ContentService.MimeType.JSON);
}
function authed_(p){ return !!p.token && String(p.token) === String(API_TOKEN) && !/PASTE/.test(API_TOKEN); }

function route_(action, p, isPost){
  // Open actions (no team token): reachability check, and counsel review links (each carries its own key).
  if(action === "ping") return { ok: true, auth: authed_(p), now: Date.now(), rev: fastRev_() };
  if(action === "saveReview") return saveReview_(p);
  if(action === "myReviews") return myReviews_(p);
  if(!authed_(p)) return { ok: false, error: "unauthorized" };
  switch(action){
    case "pull":        return pull_(parseInt(p.since, 10) || 0, Math.min(parseInt(p.limit, 10) || 600, 1500));
    case "health":      return healthReport_();
    case "push":        if(!isPost) break; return push_(p);
    case "sendEmail":   if(!isPost) break; return sendEmail_(p);
    case "uploadFile":  if(!isPost) break; return uploadFile_(p);
    case "purgeFiles":  if(!isPost) break; return purgeFiles_(p);
    case "fileStatus":  return fileStatus_(p);
    case "restoreFiles":if(!isPost) break; return restoreFiles_(p);
    case "repairFiles": if(!isPost) break; return repairFiles_(p);
    case "aiChat":      return (typeof aiChat_ === "function") ? aiChat_(p.q, p.cohortId) : { ok: false, error: "AI.gs is not installed" };
    case "vetNow":
    case "aiRun":       return (typeof aiRunNow_ === "function") ? Object.assign({ ok: true }, aiRunNow_(p)) : { ok: false, error: "AI.gs is not installed" };
    case "aiDraft":     return (typeof aiDraft_ === "function") ? aiDraft_(p) : { ok: false, error: "AI.gs is not installed" };
    case "aiQuestions": return (typeof aiQuestions_ === "function") ? aiQuestions_(p) : { ok: false, error: "AI.gs is not installed" };
    case "calendarInvite": if(!isPost) break; return calendarInvite_(p);
    case "replyThread": if(!isPost) break; return replyThread_(p);
    case "sheetExport": if(!isPost) break; return sheetExport_(p);
  }
  return { ok: false, error: "unknown action: " + action };
}

/* ============================== the store ============================== */
// One JSON file in the Drive folder. Records carry _rev (a counter bumped on every change) so each device
// downloads only what changed since its last sync. Deletions are permanent tombstones.
const STATE_FILE = "cohort_state.json";
const SETTING_KEYS = ["team","counsels","savedOptions","emailTemplates","whatsappMsgs","inviteText","inviteAssoc","noReplyList",
  "reportingDetails","officeLocation","offerFiles","logoUrl","aiLessons","appUrl","automation","teamEmails"];

function storeFile_(){
  const folder = DriveApp.getFolderById(CV_FOLDER_ID);
  const it = folder.getFilesByName(STATE_FILE);
  if(it.hasNext()) return it.next();
  const f = folder.createFile(STATE_FILE, "", "application/json");
  try{ f.setSharing(DriveApp.Access.PRIVATE, DriveApp.Permission.NONE); }catch(e){}
  return f;
}
function emptyStore_(){ return { schema: 4, rev: 0, cohorts: {}, candidates: {}, reports: {}, settings: {}, deleted: {}, deletedKeys: {} }; }
function loadStore_(){
  const file = storeFile_();
  let raw = file.getBlob().getDataAsString() || "";
  let st = null;
  if(raw.trim()){ try{ st = JSON.parse(raw); }catch(e){ throw new Error("The shared data file is damaged (cohort_state.json). Restore an older version from Drive (right-click → Manage versions)."); } }
  if(!st) st = emptyStore_();
  if(st.schema !== 4) st = migrateStore_(st, raw, file);
  ["cohorts","candidates","reports","settings","deleted","deletedKeys"].forEach(k => { if(!st[k] || typeof st[k] !== "object") st[k] = {}; });
  if(!st.rev) st.rev = 0;
  return st;
}
function saveStore_(st){
  delete st.__dirty;
  st.savedAt = Date.now();
  storeFile_().setContent(JSON.stringify(st));
  PropertiesService.getScriptProperties().setProperty("store_rev", String(st.rev));
}
/** Read-modify-write under the script lock. fn may return a value; the store is saved only if something changed. */
function withStore_(fn){
  const lock = LockService.getScriptLock();
  if(!lock.tryLock(30000)) throw new Error("The server is busy — try again in a moment");
  try{
    const st = loadStore_();
    const r = fn(st);
    if(st.__dirty) saveStore_(st);
    return r;
  } finally { lock.releaseLock(); }
}
function fastRev_(){ return parseInt(PropertiesService.getScriptProperties().getProperty("store_rev") || "0", 10); }
function bump_(st, rec){ rec._rev = ++st.rev; st.__dirty = true; }
function stripRev_(r){ const o = Object.assign({}, r); delete o._rev; return o; }
function getSetting_(st, k, def){ const s = st.settings && st.settings[k]; return s && s.v !== undefined ? s.v : def; }

/** Merge an incoming record; returns true when the stored copy changed. */
function putRecord_(st, kind, rec, now){
  if(!rec || !rec.id || st.deleted[rec.id]) return false;
  const cur = st[kind][rec.id];
  const merged = cur ? mergeRecord(cur, rec) : rec;
  if(kind === "candidates") normalizeCandidate(merged);
  if(kind === "cohorts") normalizeCohort(merged);
  if(cur && sameJson(stripRev_(cur), stripRev_(merged))) return false;
  st[kind][rec.id] = merged; bump_(st, merged);
  return true;
}
function deleteRecord_(st, id, ts, key){
  if(!id) return;
  st.deleted[id] = { ts: ts || Date.now(), rev: ++st.rev };
  delete st.candidates[id]; delete st.cohorts[id]; delete st.reports[id];
  if(key) st.deletedKeys[key] = ts || Date.now();
  st.__dirty = true;
}
/** Find the cohort for a month/year, or create it with the deterministic id. */
function ensureCohort_(st, month, year){
  const id = cohortIdFor(month, year);
  if(st.cohorts[id]) return st.cohorts[id];
  const k = Object.keys(st.cohorts).find(i => st.cohorts[i].month === MONTHS[monthIndex(month)] && String(st.cohorts[i].year) === String(year));
  if(k) return st.cohorts[k];
  const c = mkCohort(month, year, Date.now());
  if(st.deleted[c.id]) delete st.deleted[c.id];   // a month can always be re-opened by a new application
  st.cohorts[c.id] = c; bump_(st, c);
  return c;
}

/* ---- conversion from the V22 file format (arrays + flat settings) — runs once, keeps a backup ---- */
function migrateStore_(old, raw, file){
  try{ if(raw && raw.trim()) file.getParents().next().createFile("cohort_state_BACKUP_before_v23_" + Utilities.formatDate(new Date(), "GMT", "yyyyMMdd-HHmm") + ".json", raw, "application/json"); }catch(e){}
  const st = emptyStore_();
  const ts = old.updatedAt || Date.now();
  (old.deleted || []).forEach(t => { if(t && t.id) st.deleted[t.id] = { ts: t.ts || ts, rev: 0 }; });
  // cohorts: one per month/year
  const canon = {}, remap = {};
  const demoIds = {}; (old.cohorts || []).forEach(c => { if(c && c.demo) demoIds[c.id] = 1; });
  (old.cohorts || []).forEach(c => {
    if(!c || !c.id || st.deleted[c.id]) return;
    normalizeCohort(c);
    const k = c.month + "|" + c.year;
    const cur = canon[k];
    const better = !cur || (c.id === cohortIdFor(c.month, c.year)) || (cur.id !== cohortIdFor(cur.month, cur.year) && (c.createdAt || 0) < (cur.createdAt || 0));
    if(better){ if(cur) remap[cur.id] = c.id; canon[k] = c; } else remap[c.id] = cur.id;
    if(c.status === "closed" && canon[k] && canon[k] !== c) canon[k].status = "closed";
  });
  Object.keys(canon).forEach(k => { const c = canon[k]; delete c.demo; st.cohorts[c.id] = c; });
  // candidates: drop the sample (demo) people, re-point to canonical cohorts, clear old AI guesses
  (old.candidates || []).forEach(c => {
    if(!c || !c.id || st.deleted[c.id]) return;
    if(/@example\.com$/i.test(String(c.email || ""))){ st.deleted[c.id] = { ts: Date.now(), rev: 0 }; return; }
    normalizeCandidate(c);
    if(remap[c.cohortId]) c.cohortId = remap[c.cohortId];
    c.ai = null;
    st.candidates[c.id] = c;
  });
  // demo cohorts that now hold nobody
  Object.keys(st.cohorts).forEach(id => {
    const used = Object.keys(st.candidates).some(k => st.candidates[k].cohortId === id);
    if(!used && demoIds[id]) { delete st.cohorts[id]; st.deleted[id] = { ts: Date.now(), rev: 0 }; }
  });
  // extension targets from the old "Month Year" labels (creates the target month if needed)
  Object.keys(st.candidates).forEach(id => resolveExtTargets_(st, st.candidates[id]));
  const flat = { team: old.team, counsels: old.counsels, savedOptions: old.savedOptions, emailTemplates: old.emailTemplates,
    whatsappMsgs: old.whatsappMsgs || old.whatsapp, inviteText: old.inviteText, inviteAssoc: old.inviteAssoc, noReplyList: old.noReplyList,
    reportingDetails: old.reportingDetails, offerFiles: old.offerFiles, logoUrl: (String(old.logoUrl || "").length < 400000 ? old.logoUrl : ""), aiLessons: old.aiLessons };
  Object.keys(flat).forEach(k => { if(flat[k] !== undefined && flat[k] !== null) st.settings[k] = { v: flat[k], ts: ts, _rev: 0 }; });
  (old.aiReports || []).forEach(r => { if(r && (r.id || r.day)){ const id = r.id || ("rep_" + r.day); st.reports[id] = Object.assign({}, r, { id }); } });
  // number everything
  ["cohorts","candidates","reports"].forEach(kind => Object.keys(st[kind]).forEach(id => { st[kind][id]._rev = ++st.rev; }));
  Object.keys(st.settings).forEach(k => { st.settings[k]._rev = ++st.rev; });
  Object.keys(st.deleted).forEach(id => { st.deleted[id].rev = ++st.rev; });
  st.migratedAt = Date.now();
  st.__dirty = true;
  return st;
}
function resolveExtTargets_(st, c){
  (c.extensions || []).forEach(x => {
    if(x.targetCohortId) return;
    const m = String(x.targetLabel || "").split(" ");
    let coh = null;
    if(monthIndex(m[0]) > -1 && parseInt(m[1], 10)) coh = ensureCohort_(st, m[0], parseInt(m[1], 10));
    else { const from = st.cohorts[c.cohortId]; if(from){ const n = nextMonthOf(from.month, from.year); coh = ensureCohort_(st, n.month, n.year); } }
    if(coh){ x.targetCohortId = coh.id; x.targetLabel = coh.label; }
  });
}

/* ================================ sync ================================ */
function pull_(since, limit){
  const rev = fastRev_();
  if(since && since === rev) return { ok: true, rev, now: Date.now(), more: false, cohorts: [], candidates: [], reports: [], settings: {}, deleted: [] };
  const st = loadStore_();
  if(since > st.rev) return { ok: true, reset: true, rev: st.rev, now: Date.now() };
  const items = [];
  ["cohorts","candidates","reports"].forEach(kind => Object.keys(st[kind]).forEach(id => { const r = st[kind][id]; if((r._rev || 0) > since) items.push([r._rev, kind, r]); }));
  Object.keys(st.settings).forEach(k => { const s = st.settings[k]; if((s._rev || 0) > since) items.push([s._rev, "settings", k]); });
  Object.keys(st.deleted).forEach(id => { const d = st.deleted[id]; if((d.rev || 0) > since) items.push([d.rev, "deleted", id]); });
  items.sort((a, b) => a[0] - b[0]);
  const page = items.slice(0, limit), more = items.length > limit;
  const out = { ok: true, now: Date.now(), more, rev: more ? page[page.length - 1][0] : st.rev, cohorts: [], candidates: [], reports: [], settings: {}, deleted: [], deletedKeys: st.deletedKeys };
  page.forEach(it => {
    if(it[1] === "settings") out.settings[it[2]] = { v: st.settings[it[2]].v, ts: st.settings[it[2]].ts };
    else if(it[1] === "deleted") out.deleted.push({ id: it[2], ts: st.deleted[it[2]].ts });
    else out[it[1]].push(it[2]);
  });
  return out;
}
function push_(p){
  const now = Date.now();
  return withStore_(st => {
    let n = 0; const remap = {};
    (p.deleted || []).forEach(d => { if(d && d.id){ deleteRecord_(st, d.id, d.ts || now, d.key || ""); n++; } });
    (p.cohorts || []).forEach(c => {
      if(!c || !c.id || c.demo) return;
      normalizeCohort(c);
      const same = Object.keys(st.cohorts).find(i => i !== c.id && st.cohorts[i].month === c.month && String(st.cohorts[i].year) === String(c.year));
      if(same){ remap[c.id] = same; return; }
      if(putRecord_(st, "cohorts", c, now)) n++;
    });
    (p.candidates || []).forEach(c => {
      if(!c || !c.id || c.demo || /@example\.com$/i.test(String(c.email || ""))) return;
      if(remap[c.cohortId]) applyChange(c, "cohortId", remap[c.cohortId], now);
      if(putRecord_(st, "candidates", c, now)){ resolveExtTargets_(st, st.candidates[c.id]); n++; }
    });
    const s = p.settings || {};
    Object.keys(s).forEach(k => {
      if(SETTING_KEYS.indexOf(k) < 0 || !s[k]) return;
      const cur = st.settings[k];
      if(!cur || (s[k].ts || 0) > (cur.ts || 0)){ st.settings[k] = { v: s[k].v, ts: s[k].ts || now, _rev: ++st.rev }; st.__dirty = true; n++; }
    });
    return { ok: true, changed: n, rev: st.rev, now: Date.now(), remap };
  });
}

/* ================================ email ================================ */
function sendEmail_(p){
  const to = cleanEmail(p.to);
  if(!to || to.indexOf("@") < 0) return { ok: false, error: "No valid email address" };
  const st = loadStore_();
  const counselEmails = (getSetting_(st, "counsels", []) || []).map(c => cleanEmail(c.email));
  const isCounsel = p.kind === "counsel" && counselEmails.indexOf(to) > -1;
  if(!isCounsel && isBlockedAddress(to, INTERNAL.concat(getSetting_(st, "noReplyList", []) || []))) return { ok: false, error: "Blocked: " + to + " is on the restricted list" };
  let quota = 0; try{ quota = MailApp.getRemainingDailyQuota(); }catch(e){}
  if(quota < 1) return { ok: false, error: "Gmail's daily sending limit is used up — try again tomorrow" };
  const atts = [];
  for(const u of (p.attachments || [])){
    const id = driveId_(u);
    try{ atts.push(DriveApp.getFileById(id).getBlob()); }
    catch(e){ return { ok: false, error: "Attachment could not be opened (" + u + "). Fix the link in Playbook → Email templates → Offer." }; }
  }
  const opts = { name: "The Chambers of Bharat Chugh" };
  if(atts.length) opts.attachments = atts;
  try{ GmailApp.sendEmail(to, String(p.subject || ""), String(p.text || ""), opts); }
  catch(e){ return { ok: false, error: "Gmail refused: " + e.message }; }
  const mail = { ts: Date.now(), key: p.key || "", name: p.tplName || p.key || "", to, ok: true, by: p.by || "—" };
  if(p.candidateId){
    try{ withStore_(s2 => { const c = s2.candidates[p.candidateId]; if(c){ c.mails.push(mail); bump_(s2, c); } }); }catch(e){}
  }
  return { ok: true, mail, quotaLeft: quota - 1 };
}

/* ================================ files ================================ */
function uploadFile_(p){
  const folder = DriveApp.getFolderById(CV_FOLDER_ID);
  const field = { cv: "cvUrl", cover: "clUrl", nda: "ndaUrl", govtid: "govtIdUrl", other: "otherUrl" }[p.slot] || "otherUrl";
  let sub = folder;
  const m = String(p.month || "").split(" ");
  if(monthIndex(m[0]) > -1 && parseInt(m[1], 10)) sub = cohortFolder_(folder, p.month, { month: MONTHS[monthIndex(m[0])], year: parseInt(m[1], 10) });
  const blob = Utilities.newBlob(Utilities.base64Decode(p.dataBase64 || ""), p.mime || "application/octet-stream", p.name || "upload");
  const f = sub.createFile(blob).setName((p.who || "Candidate") + " - " + (p.month || "") + " - " + (p.slot || "file") + " - " + (p.name || "upload"));
  shareFile_(f, p.slot === "cover" ? "cover" : (p.slot === "cv" ? "cv" : (p.slot === "other" ? "other" : "private")));
  const url = f.getUrl();
  withStore_(st => {
    const c = st.candidates[p.id];
    if(c){
      const now = Date.now();
      const v = (field === "otherUrl" && c.otherUrl) ? c.otherUrl + " , " + url : url;
      applyChange(c, field, v, now);
      c.hist.push({ ts: now, by: p.by || "—", txt: "Uploaded " + (p.slot || "file") + ": " + (p.name || "") });
      bump_(st, c);
    }
  });
  return { ok: true, url, field };
}
function purgeFiles_(p){ trashUrls_(p.urls || []); return { ok: true, count: (p.urls || []).length }; }
function fileStatus_(p){
  const res = (p.urls || []).slice(0, 60).map(u => {
    const id = driveId_(u);
    if(!id) return { url: u, status: "bad-link" };
    try{
      const f = DriveApp.getFileById(id);
      return { url: u, status: f.isTrashed() ? "trashed" : "ok", name: f.getName(), sharing: String(f.getSharingAccess()) };
    }catch(e){ return { url: u, status: "missing" }; }
  });
  return { ok: true, files: res };
}
function restoreFiles_(p){
  let n = 0;
  (p.urls || []).forEach(u => { const id = driveId_(u); if(!id) return; try{ const f = DriveApp.getFileById(id); if(f.isTrashed()){ f.setTrashed(false); n++; } }catch(e){} });
  return { ok: true, restored: n };
}
/** Walks every candidate's files: restores trashed ones, re-applies the sharing policy, reports missing ones. Resumable. */
function repairFiles_(p){
  const t0 = Date.now(), st = loadStore_();
  const ids = Object.keys(st.candidates).sort();
  let i = Math.max(0, parseInt(p.cursor, 10) || 0), restored = 0, checked = 0;
  const missing = [];
  for(; i < ids.length; i++){
    if(Date.now() - t0 > 240000) break;
    const c = st.candidates[ids[i]];
    [["cvUrl","cv"],["clUrl","cover"],["emailPdfUrl","email"],["ndaUrl","private"],["govtIdUrl","private"]].forEach(pair => {
      const u = c[pair[0]]; if(!u) return; checked++;
      try{ const f = DriveApp.getFileById(driveId_(u)); if(f.isTrashed()){ f.setTrashed(false); restored++; } shareFile_(f, pair[1]); }
      catch(e){ missing.push({ id: c.id, name: c.name, field: pair[0] }); }
    });
  }
  return { ok: true, done: i >= ids.length, cursor: i, total: ids.length, restored, checked, missing };
}

/* ============================= counsel reviews ============================ */
function saveReview_(p){
  const RATING_KEYS = ["drafting","research","punctuality","diligence","court","analysis","initiative","zeal"];
  return withStore_(st => {
    const c = st.candidates[p.id];
    if(!c || !c.reviewReq) return { ok: false, error: "This intern is no longer in the system" };
    const entry = (c.reviewReq.counsels || []).find(x => x.key && x.key === p.key);
    if(!entry) return { ok: false, error: "This review link is not valid any more — ask the team for a fresh one" };
    const r = p.review || {};
    const ratings = {};
    RATING_KEYS.forEach(k => { const v = parseInt((r.ratings || {})[k], 10); if(v >= 1 && v <= 5) ratings[k] = v; });
    const rv = { by: entry.name, email: entry.email || "", round: c.reviewReq.round || "", ts: Date.now(),
      worked: r.worked === "no" ? "no" : "yes", ratings: r.worked === "no" ? {} : ratings,
      recommend: r.worked === "no" ? "na" : (["rec","rec_no","no_op"].indexOf(r.recommend) > -1 ? r.recommend : ""),
      stipend: ["yes","no"].indexOf(r.stipend) > -1 ? r.stipend : "", comments: String(r.comments || "").slice(0, 4000) };
    c.reviews = (c.reviews || []).filter(x => !(x.by === rv.by && (x.round || "") === rv.round));
    c.reviews.push(rv);
    c.hist.push({ ts: rv.ts, by: rv.by, txt: "Counsel review received" });
    const pending = (c.reviewReq.counsels || []).filter(x => !c.reviews.some(y => y.by === x.name && (y.round || "") === rv.round));
    if(!pending.length) applyChange(c, "reviewReq.active", false, rv.ts);
    bump_(st, c);
    return { ok: true };
  });
}
function myReviews_(p){
  const st = loadStore_(), out = {};
  (p.ids || String(p.idList || "").split(",")).forEach(id => {
    const c = st.candidates[id]; if(!c || !c.reviewReq) return;
    const entry = (c.reviewReq.counsels || []).find(x => x.key && x.key === p.key); if(!entry) return;
    const r = (c.reviews || []).find(x => x.by === entry.name && (x.round || "") === (c.reviewReq.round || ""));
    if(r) out[id] = { worked: r.worked, ratings: r.ratings, recommend: r.recommend, stipend: r.stipend, comments: r.comments };
  });
  return { ok: true, reviews: out };
}

/* ================================ health ================================ */
function healthReport_(){
  const out = { ok: true, now: Date.now(), tz: Session.getScriptTimeZone(), checks: [] };
  const add = (ok, label, detail) => out.checks.push({ ok, label, detail: detail || "" });
  try{ const sh = appSheet_(); add(true, "Applications Sheet", Math.max(0, sh.getLastRow() - 1) + " rows"); }catch(e){ add(false, "Applications Sheet", e.message); }
  try{
    const f = DriveApp.getFolderById(CV_FOLDER_ID);
    add(!f.isTrashed(), "Drive folder", f.isTrashed() ? "The folder is in the Drive trash — restore it" : f.getName());
    const sf = storeFile_(); add(true, "Shared data file", Math.round(sf.getSize() / 1024) + " KB · rev " + fastRev_());
  }catch(e){ add(false, "Drive folder", e.message); }
  try{ add(true, "Gmail sending", MailApp.getRemainingDailyQuota() + " emails left today"); }catch(e){ add(false, "Gmail sending", e.message); }
  const trig = ScriptApp.getProjectTriggers().map(t => t.getHandlerFunction());
  add(trig.indexOf("processInbox") > -1, "Intake timer", trig.indexOf("processInbox") > -1 ? "every 10 min" : "missing — run setup() in Apps Script");
  add(!aiEnabled_() || trig.indexOf("aiVetPending") > -1, "AI timer", aiEnabled_() ? (trig.indexOf("aiVetPending") > -1 ? "every 30 min" : "missing — run setup()") : "AI off (no Groq key)");
  add(true, "File access", effectiveSharing_() === "team" ? (TEAM_EMAILS.length + " team account(s) can open files") : "anyone with the link (CV / cover / email PDF); IDs & NDAs owner-only" + (FILE_SHARING === "team" ? " — add TEAM_EMAILS in Code.gs to lock down" : ""));
  ["intake","ai","nightly","reminders"].forEach(k => {
    const h = getHealth_(k); if(!h) return;
    const age = Math.round((Date.now() - h.ts) / 60000);
    let d = (age < 120 ? age + " min ago" : Math.round(age / 60) + " h ago");
    if(k === "intake" && h.ok) d += " · filed " + (h.filed || 0) + ", updated " + (h.updated || 0) + ", needs-fix " + (h.needsFix || 0) + ", ignored " + (h.ignored || 0) + (h.errors ? ", errors " + h.errors : "");
    if(k === "ai" && h.ok) d += " · vetted " + (h.vetted || 0);
    if(h.err) d += " · " + h.err;
    add(!!h.ok && !(k === "intake" && age > 90), "Last " + k + " run", d);
  });
  out.webAppUrl = (function(){ try{ return ScriptApp.getService().getUrl(); }catch(e){ return ""; } })();
  out.ai = { enabled: aiEnabled_(), info: aiProviderInfo_(), gemini: keySet_(GEMINI_API_KEY), groq: keySet_(GROQ_API_KEY), provider: AI_PROVIDER,
    canReadFiles: typeof Drive !== "undefined" || keySet_(GEMINI_API_KEY), driveService: typeof Drive !== "undefined", calendarService: typeof Calendar !== "undefined",
    last: getHealth_("ai"), budgetMin: Math.round(budgetUsed_() / 60000) };
  add(true, "AI", aiEnabled_() ? aiProviderInfo_() : "off — add a Gemini or Groq key in Code.gs");
  add(true, "Reading CVs", typeof Drive !== "undefined" ? "PDF, Word and scans (Drive API service on)" : (keySet_(GEMINI_API_KEY) ? "PDFs via Gemini; turn on the Drive API service for Word files and a fallback" : "email text only — turn on the Drive API service"));
  add(!budgetLow_(), "Google run-time today", Math.round(budgetUsed_() / 60000) + " of ~90 min");
  return out;
}


/* ============================ Calendar, Gmail, Sheets ============================ */
/** Creates or updates a Google Calendar invite for each interview (candidate + interviewer as guests).
 *  With the Calendar API service on, online interviews get a Google Meet link automatically. */
function calendarInvite_(p){
  const st = loadStore_(), results = [], writes = [];
  const teamEmails = getSetting_(st, "teamEmails", {}) || {};
  const mins = Math.max(10, parseInt(p.minutes, 10) || 20);
  (p.ids || []).slice(0, 40).forEach(id => {
    const c = st.candidates[id]; if(!c){ results.push({ id, ok: false, error: "not found" }); return; }
    const iv = c.interview || {};
    if(!iv.date || !iv.slot){ results.push({ id, name: c.name, ok: false, error: "no date/time" }); return; }
    if(!c.email || isBlockedAddress(c.email, getSetting_(st, "noReplyList", []) || [])){ results.push({ id, name: c.name, ok: false, error: "no usable email" }); return; }
    const coh = st.cohorts[c.cohortId] || {};
    const start = new Date(istTs(iv.date, iv.slot)), end = new Date(start.getTime() + mins * 60000);
    const guests = [c.email]; const ie = teamEmails[iv.by]; if(ie && /@/.test(ie)) guests.push(ie);
    const title = "Interview — " + c.name + " (" + (coh.label || "") + " " + (c.track === "associate" ? "Associate" : "internship") + ")";
    const online = c.processMode === "online";
    const desc = "Interview with the Chambers of Bharat Chugh.\n" + (online ? "Online — join with the link in this invite." : "In person: " + (getSetting_(st, "reportingDetails", "") || "")) + "\n\nIf you cannot make it, please reply to our email.";
    try{
      let eventId = iv.eventId || "", link = iv.link || "";
      if(typeof Calendar !== "undefined"){
        const body = { summary: title, description: desc, start: { dateTime: start.toISOString() }, end: { dateTime: end.toISOString() }, attendees: guests.map(e => ({ email: e })) };
        if(!online) body.location = getSetting_(st, "reportingDetails", "") || "";
        let ev;
        if(eventId){ try{ ev = Calendar.Events.patch(body, "primary", eventId, { sendUpdates: "all" }); }catch(e){ ev = null; } }
        if(!ev){ if(online && !link) body.conferenceData = { createRequest: { requestId: Utilities.getUuid(), conferenceSolutionKey: { type: "hangoutsMeet" } } };
          ev = Calendar.Events.insert(body, "primary", { conferenceDataVersion: 1, sendUpdates: "all" }); }
        eventId = ev.id; if(online && !link && ev.hangoutLink) link = ev.hangoutLink;
      } else {
        const cal = CalendarApp.getDefaultCalendar();
        let ev = eventId ? cal.getEventById(eventId) : null;
        if(ev){ ev.setTime(start, end); }
        else { ev = cal.createEvent(title, start, end, { guests: guests.join(","), sendInvites: true, description: desc, location: online ? "" : (getSetting_(st, "reportingDetails", "") || "") }); }
        eventId = ev.getId();
      }
      writes.push({ id, eventId, link, when: iv.date + " " + iv.slot });
      results.push({ id, name: c.name, ok: true, eventId, link });
    }catch(e){ results.push({ id, name: c.name, ok: false, error: String(e.message || e).slice(0, 160) }); }
  });
  if(writes.length) withStore_(st2 => { const now = Date.now(); writes.forEach(w => { const c = st2.candidates[w.id]; if(!c) return;
    applyChange(c, "interview.eventId", w.eventId, now); if(w.link && !(c.interview || {}).link) applyChange(c, "interview.link", w.link, now);
    applyChange(c, "interview.invited", w.when, now);
    c.hist.push({ ts: now, by: p.by || "—", txt: "Calendar invite sent for " + w.when + (w.link ? " (Meet link added)" : "") }); bump_(st2, c); }); });
  return { ok: true, results, meet: typeof Calendar !== "undefined" };
}
/** Replies inside the candidate's own Gmail thread (keeps the conversation together in the inbox). */
function replyThread_(p){
  const st = loadStore_(), c = st.candidates[p.cid];
  if(!c) return { ok: false, error: "Candidate not found" };
  if(!c.email || isBlockedAddress(c.email, INTERNAL.concat(getSetting_(st, "noReplyList", []) || []))) return { ok: false, error: "This address is restricted" };
  let quota = 0; try{ quota = MailApp.getRemainingDailyQuota(); }catch(e){}
  if(quota < 1) return { ok: false, error: "Gmail's daily sending limit is used up — try again tomorrow" };
  let th = null; try{ th = GmailApp.getThreadById(p.threadId || c.gmailThread); }catch(e){}
  try{
    if(th && replyableThread_(th, c.email)) th.reply(String(p.text || ""), { name: "The Chambers of Bharat Chugh", subject: p.subject || undefined });
    else GmailApp.sendEmail(c.email, String(p.subject || "Re: your application"), String(p.text || ""), { name: "The Chambers of Bharat Chugh" });
  }catch(e){ return { ok: false, error: "Gmail refused: " + e.message }; }
  const mail = { ts: Date.now(), key: "reply", name: "Reply" + (p.subject ? ": " + String(p.subject).slice(0, 60) : ""), to: c.email, ok: true, by: p.by || "—" };
  withStore_(s2 => { const x = s2.candidates[c.id]; if(!x) return; x.mails.push(mail);
    if(p.msgId){ const it = (x.inbox || []).find(i => i.msgId === p.msgId); if(it){ it.handled = true; it.handledBy = p.by || "—"; } resolveFlag_(x, "reply_" + p.msgId, p.by || "—", Date.now()); }
    bump_(s2, x); });
  return { ok: true, mail };
}
/** Writes a table from the dashboard into a new tab of the Cohort Sheet and returns its link. */
function sheetExport_(p){
  const ss = SpreadsheetApp.openById(SHEET_ID);
  const name = String(p.title || "Export").replace(/[\[\]\*\?\/\\:]/g, " ").slice(0, 60) + " " + Utilities.formatDate(new Date(), "Asia/Kolkata", "d MMM HH:mm");
  const sh = ss.insertSheet(name);
  const rows = [p.header || []].concat(p.rows || []).map(r => r.map(v => (typeof v === "string" && /^[=+\-@]/.test(v)) ? "'" + v : (v == null ? "" : v)));
  const w = Math.max.apply(null, rows.map(r => r.length));
  if(rows.length && w) sh.getRange(1, 1, rows.length, w).setValues(rows.map(r => r.concat(Array(w - r.length).fill(""))));
  try{ sh.setFrozenRows(1); }catch(e){}
  return { ok: true, url: ss.getUrl() + "#gid=" + sh.getSheetId(), name };
}
